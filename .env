# Existing
DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- NextAuth (real Google OAuth wiring) ---
# Secret used to sign JWTs. Generated with: openssl rand -base64 32
NEXTAUTH_SECRET=ajeWHTAPRhwSuAAi6AAoSI9eL09nRli0Xn35zufsTm0=

# Public URL of the app. For the sandbox preview, set this to your preview URL.
# Examples:
#   Local dev:        http://localhost:3000
#   Sandbox preview:  https://preview-<your-bot-id>.space-z.ai/
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth credentials (from Google Cloud Console) ---
# Leave commented to use the built-in demo Google account picker.
# Uncomment + fill in to enable REAL Google Sign-In:
#
#   1. Go to https://console.cloud.google.com/
#   2. Create (or pick) a project → APIs & Services → OAuth consent screen
#      - User type: External (or Test if internal)
#      - Add the scope 'userinfo.email' and 'userinfo.profile'
#   3. APIs & Services → Credentials → Create Credentials → OAuth client ID
#      - Application type: Web application
#      - Authorized JavaScript origins: <your NEXTAUTH_URL>
#      - Authorized redirect URI:  <NEXTAUTH_URL>/api/auth/callback/google
#          e.g. http://localhost:3000/api/auth/callback/google
#               https://preview-<bot-id>.space-z.ai/api/auth/callback/google
#   4. Copy the Client ID + Client Secret below.
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
